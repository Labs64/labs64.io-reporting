<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.labs64</groupId>
    <artifactId>reporting</artifactId>
    <!-- Set by the release tag (-Drevision=<tag>); the 0.0.0-SNAPSHOT default is inherited. -->
    <version>${revision}</version>
    <packaging>jar</packaging>

    <name>Labs64.IO :: Reporting</name>
    <description>Labs64.IO - read-only reports over the events a tenant's AuditFlow sinks stored</description>

    <parent>
        <groupId>io.labs64</groupId>
        <artifactId>labs64io-parent</artifactId>
        <version>0.1.3</version>
        <relativePath />
    </parent>

    <properties>
        <aws-sdk.version>2.57.8</aws-sdk.version>
        <!-- 2.x: Docker 29 no longer speaks the API version of 1.x. -->
        <testcontainers.version>2.0.5</testcontainers.version>

        <!-- Ahead of what Spring Boot and the parent manage. Jackson moves as a pair and only within the minor line Boot
             ships (3.1.x with 2.21.x): leaving that line has crash-looped pods before. -->
        <!-- renovate: datasource=maven depName=tools.jackson:jackson-bom allowedVersions=/^3\.1\./ -->
        <jackson-bom.version>3.1.8</jackson-bom.version>
        <!-- renovate: datasource=maven depName=com.fasterxml.jackson:jackson-bom allowedVersions=/^2\.21\./ -->
        <jackson-2-bom.version>2.21.8</jackson-2-bom.version>
        <!-- renovate: datasource=maven depName=io.opentelemetry:opentelemetry-bom -->
        <opentelemetry.version>1.67.0</opentelemetry.version>
        <!-- renovate: datasource=maven depName=com.google.guava:guava -->
        <guava.version>33.7.2-android</guava.version>
        <!-- renovate: datasource=maven depName=io.grpc:grpc-bom -->
        <grpc.version>1.85.1</grpc.version>
        <!-- renovate: datasource=maven depName=org.springdoc:springdoc-openapi-bom -->
        <springdoc.version>3.2.0</springdoc.version>
        <!-- renovate: datasource=maven depName=org.openapitools:jackson-databind-nullable -->
        <openapitools.version>0.2.13</openapitools.version>
        <!-- renovate: datasource=maven depName=org.yaml:snakeyaml -->
        <snakeyaml.version>2.7</snakeyaml.version>
        <!-- renovate: datasource=maven depName=io.prometheus:prometheus-metrics-bom -->
        <prometheus-client.version>1.10.0</prometheus-client.version>
        <!-- renovate: datasource=maven depName=ch.qos.logback:logback-classic -->
        <logback.version>1.6.6</logback.version>
        <!-- renovate: datasource=maven depName=org.apache.logging.log4j:log4j-bom -->
        <log4j2.version>2.26.1</log4j2.version>
        <!-- renovate: datasource=maven depName=com.fasterxml:classmate -->
        <classmate.version>1.8.0</classmate.version>
        <!-- renovate: datasource=maven depName=commons-logging:commons-logging -->
        <commons-logging.version>1.4.0</commons-logging.version>
        <!-- renovate: datasource=maven depName=commons-codec:commons-codec -->
        <commons-codec.version>1.23.0</commons-codec.version>
        <!-- renovate: datasource=maven depName=org.junit:junit-bom -->
        <junit-jupiter.version>6.1.3</junit-jupiter.version>
        <!-- renovate: datasource=maven depName=org.mockito:mockito-bom -->
        <mockito.version>5.24.0</mockito.version>
        <!-- renovate: datasource=maven depName=net.bytebuddy:byte-buddy -->
        <byte-buddy.version>1.18.16</byte-buddy.version>
        <!-- renovate: datasource=maven depName=com.jayway.jsonpath:json-path -->
        <json-path.version>3.0.0</json-path.version>
        <!-- renovate: datasource=maven depName=org.xmlunit:xmlunit-core -->
        <xmlunit2.version>2.14.0</xmlunit2.version>

        <!-- renovate: datasource=maven depName=org.apache.maven.plugins:maven-surefire-plugin -->
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <!-- renovate: datasource=maven depName=org.apache.maven.plugins:maven-failsafe-plugin -->
        <maven-failsafe-plugin.version>3.6.1</maven-failsafe-plugin.version>
        <!-- renovate: datasource=maven depName=org.apache.maven.plugins:maven-enforcer-plugin -->
        <maven-enforcer-plugin.version>3.7.0</maven-enforcer-plugin.version>
        <!-- renovate: datasource=maven depName=org.apache.maven.plugins:maven-install-plugin -->
        <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
        <!-- renovate: datasource=maven depName=org.apache.maven.plugins:maven-deploy-plugin -->
        <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>
        <!-- renovate: datasource=maven depName=org.apache.maven.plugins:maven-site-plugin -->
        <maven-site-plugin.version>3.22.0</maven-site-plugin.version>
        <openapi.source>${project.basedir}/src/main/resources/openapi/openapi-reporting-v1.yaml</openapi.source>
        <openapi.generated>${project.build.directory}/generated-openapi/openapi-reporting-v1.yaml</openapi.generated>
        <!-- auth-policy.module must equal the module's gateway prefix (policy-sources.yaml name). -->
        <auth-policy-cerbos.output>${project.build.directory}/cerbos</auth-policy-cerbos.output>
        <auth-public-paths.generated>${project.build.directory}/generated-resources/auth-public-paths</auth-public-paths.generated>
        <auth-policy.module>reporting</auth-policy.module>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- The openapi starter pins an older springdoc, so the property alone doesn't reach it. -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-bom</artifactId>
                <version>${springdoc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Both reach us through the Cerbos SDK, which pins older ones. -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>io.labs64</groupId>
            <artifactId>auth-context-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.labs64</groupId>
            <artifactId>auth-context-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.labs64</groupId>
            <artifactId>openapi-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openapitools</groupId>
            <artifactId>jackson-databind-nullable</artifactId>
            <version>${openapitools.version}</version>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sts</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <pluginManagement>
            <plugins>
                <!-- Neither Spring Boot nor the parent manages it, so Maven's own default would apply. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>${maven-site-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- *IT needs Docker and skips itself without it. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>generate-auth-openapi-policy</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>io.labs64.authcontext.openapi.OpenApiAuthPreprocessorCli</mainClass>
                            <classpathScope>compile</classpathScope>
                            <arguments>
                                <argument>--input</argument>
                                <argument>${openapi.source}</argument>
                                <argument>--openapi-output</argument>
                                <argument>${openapi.generated}</argument>
                                <argument>--cerbos-output</argument>
                                <argument>${auth-policy-cerbos.output}</argument>
                                <argument>--public-paths-output</argument>
                                <argument>${auth-public-paths.generated}</argument>
                                <argument>--module</argument>
                                <argument>${auth-policy.module}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>labs64.io-reporting</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>generate-sources</phase>
                        <configuration>
                            <inputSpec>${openapi.generated}</inputSpec>
                            <generatorName>spring</generatorName>
                            <output>${project.build.directory}/generated-sources</output>
                            <apiPackage>io.labs64.reporting.api</apiPackage>
                            <modelPackage>io.labs64.reporting.model</modelPackage>
                            <generateSupportingFiles>true</generateSupportingFiles>
                            <configOptions>
                                <useTags>true</useTags>
                                <interfaceOnly>true</interfaceOnly>
                                <useSpringBoot3>true</useSpringBoot3>
                                <openApiNullable>false</openApiNullable>
                                <unhandledException>false</unhandledException>
                                <containerDefaultToNull>true</containerDefaultToNull>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>${build-helper-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>add-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/src/main/java</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-generated-resources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-resource</goal>
                        </goals>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/generated-resources</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
